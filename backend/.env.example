# Development. Copy to backend/.env on each computer. Never commit backend/.env.
# Both laptops use this same Supabase project.

APP_ENV=development
SECRET_KEY=replace-with-a-long-random-string

# Supabase → Connect → Session pooler. Keep the postgresql+psycopg:// prefix.
# Do not use localhost. Do not use the direct db host on the free plan (it is IPv6-only).
DATABASE_URL=

CORS_ORIGINS=http://localhost:3000,http://localhost:3001
AUTH_MODE=supabase
EXPOSE_DEV_TOKENS=false
ACCESS_TOKEN_EXPIRE_MINUTES=60
JOB_POLL_SECONDS=2

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents

# Optional. A second, disposable Supabase project for pytest. Never the database above.
# TEST_DATABASE_URL=

# AI providers. Keys stay in this file. Leave a key blank until you have one.
GEMINI_API_KEY=
GROQ_API_KEY=
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDERS=groq,ollama
GEMINI_MODEL=gemini-flash-lite-latest
GROQ_MODEL=openai/gpt-oss-20b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
AI_REQUEST_TIMEOUT_SECONDS=30
AI_HEALTH_TIMEOUT_SECONDS=5
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
ANALYST_MAX_BYTES=5000000
ANALYST_MAX_ROWS=20000
ANALYST_MAX_COLUMNS=40
# full keeps local uploads and semantic indexing. The hosted API uses demo.
KNOWLEDGE_MODE=full
