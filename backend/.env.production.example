# Production. Set these on Render. Do not reuse the development database if you want a separate live project.

APP_ENV=production
SECRET_KEY=
DATABASE_URL=
CORS_ORIGINS=https://your-app.vercel.app
AUTH_MODE=supabase
EXPOSE_DEV_TOKENS=false
ACCESS_TOKEN_EXPIRE_MINUTES=60
JOB_POLL_SECONDS=2
SUPABASE_URL=https://YOUR_PRODUCTION_PROJECT_REF.supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents
GEMINI_API_KEY=
GROQ_API_KEY=
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDERS=groq
GEMINI_MODEL=gemini-flash-lite-latest
GROQ_MODEL=openai/gpt-oss-20b
OLLAMA_BASE_URL=
OLLAMA_MODEL=
KNOWLEDGE_MODE=demo
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
