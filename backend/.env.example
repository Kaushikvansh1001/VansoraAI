# Development. Copy to backend/.env on each computer. Never commit backend/.env.
# Both laptops use this same Supabase project.

APP_ENV=development
SECRET_KEY=replace-with-a-long-random-string

# Supabase → Connect → Session pooler. Keep the postgresql+psycopg:// prefix.
# Do not use localhost. Do not use the direct db host on the free plan (it is IPv6-only).
DATABASE_URL=

CORS_ORIGINS=http://localhost:3000,http://localhost:3001
AUTH_MODE=supabase
EXPOSE_DEV_TOKENS=false
ACCESS_TOKEN_EXPIRE_MINUTES=60
JOB_POLL_SECONDS=2

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents

# Optional. A second, disposable Supabase project for pytest. Never the database above.
# TEST_DATABASE_URL=
